# Cloudflare Pages headers (the vercel.json equivalent). Pages already sends
# "max-age=0, must-revalidate" for everything else, which is what index.html and sw.js
# need so a new deploy reaches installed apps.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# File names carry a content hash, so a changed file is a new URL: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
